 "components": {
  "schemas": {
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "LoginIn": {
    "properties": {
     "email": {
      "type": "string",
      "format": "email",
      "title": "Email"
     },
     "senha": {
      "type": "string",
      "title": "Senha"
     }
    },
    "type": "object",
    "required": [
     "email",
     "senha"
    ],
    "title": "LoginIn"
   },
   "LoteCemadenIn": {
    "properties": {
     "registros": {
      "items": {
       "$ref": "#/components/schemas/RegistroCemadenIn"
      },
      "type": "array",
      "maxItems": 500,
      "minItems": 1,
      "title": "Registros"
     }
    },
    "type": "object",
    "required": [
     "registros"
    ],
    "title": "LoteCemadenIn"
   },
   "Magnitude": {
    "type": "string",
    "enum": [
     "PP",
     "MP",
     "GP"
    ],
    "title": "Magnitude"
   },
   "OcorrenciaIn": {
    "properties": {
     "tipo": {
      "$ref": "#/components/schemas/TipoOcorrencia"
     },
     "descricao": {
      "type": "string",
      "maxLength": 500,
      "minLength": 3,
      "title": "Descricao"
     },
     "lat": {
      "type": "number",
      "maximum": 90.0,
      "minimum": -90.0,
      "title": "Lat"
     },
     "lon": {
      "type": "number",
      "maximum": 180.0,
      "minimum": -180.0,
      "title": "Lon"
     },
     "severidade": {
      "type": "integer",
      "maximum": 5.0,
      "minimum": 1.0,
      "title": "Severidade",
      "default": 1
     },
     "criada_em_cliente": {
      "anyOf": [
       {
        "type": "string",
        "format": "date-time"
       },
       {
        "type": "null"
       }
      ],
      "title": "Criada Em Cliente"
     },
     "midia_url": {
      "anyOf": [
       {
        "type": "string",
        "maxLength": 300
       },
       {
        "type": "null"
       }
      ],
      "title": "Midia Url"
     }
    },
    "type": "object",
    "required": [
     "tipo",
     "descricao",
     "lat",
     "lon"
    ],
    "title": "OcorrenciaIn"
   },
   "OcorrenciaPatch": {
    "properties": {
     "versao": {
      "type": "integer",
      "minimum": 1.0,
      "title": "Versao"
     },
     "descricao": {
      "anyOf": [
       {
        "type": "string",
        "maxLength": 500,
        "minLength": 3
       },
       {
        "type": "null"
       }
      ],
      "title": "Descricao"
     },
     "severidade": {
      "anyOf": [
       {
        "type": "integer",
        "maximum": 5.0,
        "minimum": 1.0
       },
       {
        "type": "null"
       }
      ],
      "title": "Severidade"
     },
     "status": {
      "anyOf": [
       {
        "$ref": "#/components/schemas/StatusOcorrencia"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "type": "object",
    "required": [
     "versao"
    ],
    "title": "OcorrenciaPatch"
   },
   "RegistroCemadenIn": {
    "properties": {
     "id_externo": {
      "type": "integer",
      "minimum": 1.0,
      "title": "Id Externo"
     },
     "data": {
      "type": "string",
      "format": "date",
      "title": "Data"
     },
     "uf": {
      "type": "string",
      "maxLength": 2,
      "minLength": 2,
      "title": "Uf"
     },
     "municipio": {
      "type": "string",
      "maxLength": 80,
      "minLength": 1,
      "title": "Municipio"
     },
     "tipologia": {
      "$ref": "#/components/schemas/Tipologia"
     },
     "magnitude": {
      "$ref": "#/components/schemas/Magnitude"
     },
     "precisao_local": {
